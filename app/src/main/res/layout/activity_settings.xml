<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azretr_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הגדרות"
            android:textColor="@color/azretr_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:padding="16dp"
            android:background="@color/azretr_card"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ערוץ יעד"
                android:textColor="@color/azretr_text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTargetUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@username"
                android:inputType="text"
                android:textColor="@color/azretr_text"
                android:textColorHint="@color/azretr_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="מילות מפתח להתראות"
                android:textColor="@color/azretr_text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="לדוגמה: דחוף, מבצע, מחיר"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/azretr_text"
                android:textColorHint="@color/azretr_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="חתימה"
                android:textColor="@color/azretr_text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSignature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="חתימה להודעות"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/azretr_text"
                android:textColorHint="@color/azretr_text_secondary" />

            <ImageView
                android:id="@+id/ivCurrentLogo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@color/azretr_divider"
                android:contentDescription="logo" />

            <Button
                android:id="@+id/btnSelectLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="בחר לוגו" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="שמור הגדרות" />

            <Button
                android:id="@+id/btnClearCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ניקוי קאש" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
