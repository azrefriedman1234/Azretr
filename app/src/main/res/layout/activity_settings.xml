<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08111A"
    android:fillViewport="true"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#122031"
            app:cardCornerRadius="20dp"
            app:strokeColor="#223645"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="הגדרות"
                    android:textColor="#F4F7FA"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="יעד, לוגו וחתימה קבועה לטקסט"
                    android:textColor="#95A8B7"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:text="יעד לשליחה"
                    android:textColor="#F4F7FA"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTargetUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#223645"
                    android:hint="@channel_username"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#95A8B7" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:text="חתימה קבועה לכל הודעת טקסט"
                    android:textColor="#F4F7FA"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="אפשר לשים קישורים. לא תוצג להם תצוגה מקדימה."
                    android:textColor="#95A8B7"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etSignature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#223645"
                    android:gravity="top|start"
                    android:hint="לדוגמה:\nהצטרפו: https://t.me/yourchannel"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="textMultiLine|textUri"
                    android:minLines="4"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#95A8B7" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:text="לוגו נוכחי"
                    android:textColor="#F4F7FA"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCurrentLogo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="#0C1824"
                    android:scaleType="fitCenter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectLogo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="בחירת לוגו"
                    app:backgroundTint="#163B33"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/btnClearCache"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="ניקוי קאש"
                    android:textColor="#F4F7FA"
                    app:cornerRadius="18dp"
                    app:strokeColor="#223645" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="שמירת הגדרות"
                    android:textStyle="bold"
                    app:backgroundTint="#36FFB9"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
