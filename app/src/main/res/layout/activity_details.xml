<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A06">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/cy_card"
                app:cardCornerRadius="6dp"
                app:strokeColor="@color/cy_stroke_soft"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="420dp"
                        android:adjustViewBounds="false"
                        android:background="@color/cy_bg_2"
                        android:scaleType="fitCenter" />

                    <com.pasiflonet.mobile.ui.DrawingView
                        android:id="@+id/drawingView"
                        android:layout_width="match_parent"
                        android:layout_height="420dp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivDraggableLogo"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="top|start"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cy_card"
                app:cardCornerRadius="6dp"
                app:strokeColor="@color/cy_stroke_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="Edit"
                        android:textColor="#E9FFF0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeLogo"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="לוגו / סימן"
                            android:textColor="@color/cy_text"
                            app:backgroundTint="#00E676"
                            app:cornerRadius="6dp" />

                        <Space
                            android:layout_width="6dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnModeBlur"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="BLUR"
                            android:textColor="#E9FFF0"
                            app:cornerRadius="6dp"
                            app:strokeColor="#E9FFF0" />

                        <Space
                            android:layout_width="6dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnTranslate"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="תרגום"
                            android:textColor="#E9FFF0"
                            app:cornerRadius="6dp"
                            app:strokeColor="#E9FFF0" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="end"
                        android:text="גודל לוגו"
                        android:textColor="#E9FFF0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/sbLogoSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:max="100"
                        android:progress="20" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSend"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="שליחה"
                            android:textStyle="bold"
                            app:backgroundTint="#00C853"
                            app:cornerRadius="6dp" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnCancel"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="ביטול"
                            android:textColor="#E9FFF0"
                            app:cornerRadius="6dp"
                            app:strokeColor="#E9FFF0" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="start"
                        android:text="כיתוב / טקסט"
                        android:textColor="#E9FFF0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCaption"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="2dp"
                        android:background="#0F1B12"
                        android:gravity="top|right"
                        android:hint="כתוב כאן טקסט"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textMultiLine|textCapSentences"
                        android:scrollHorizontally="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:cursorVisible="true"
                        android:longClickable="true"
                        android:layoutDirection="rtl"
                        android:textDirection="rtl"
                        android:minLines="5"
                        android:maxLines="200"
                        android:overScrollMode="always"
                        android:padding="6dp"
                        android:scrollbars="vertical"
                        android:textColor="#E9FFF0"
                        android:textColorHint="#7FD9A4"
                        android:textSize="12sp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
