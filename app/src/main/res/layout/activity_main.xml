<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <ScrollView
        android:id="@+id/apiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AZRETR CYBER"
                android:textColor="@color/cyber_green"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center" />

            <EditText
                android:id="@+id/etApiId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API ID"
                android:inputType="number"
                android:layout_marginTop="20dp"
                android:background="@drawable/cyber_edit_bg"
                android:textColor="@color/cyber_text"
                android:textColorHint="@color/cyber_muted" />

            <EditText
                android:id="@+id/etApiHash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API HASH"
                android:inputType="text"
                android:layout_marginTop="12dp"
                android:background="@drawable/cyber_edit_bg"
                android:textColor="@color/cyber_text"
                android:textColorHint="@color/cyber_muted" />

            <Button
                android:id="@+id/btnSaveApi"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="שמירה"
                android:background="@drawable/cyber_button_bg"
                android:textColor="@color/cyber_green" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="התחברות"
                android:textColor="@color/cyber_green"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/phoneLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:background="@drawable/cyber_panel_bg">

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="מספר טלפון"
                    android:inputType="phone"
                    android:background="@drawable/cyber_edit_bg"
                    android:textColor="@color/cyber_text"
                    android:textColorHint="@color/cyber_muted" />

                <Button
                    android:id="@+id/btnSendCode"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="שלח קוד"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/codeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                android:background="@drawable/cyber_panel_bg">

                <EditText
                    android:id="@+id/etCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="קוד אימות"
                    android:inputType="number"
                    android:background="@drawable/cyber_edit_bg"
                    android:textColor="@color/cyber_text"
                    android:textColorHint="@color/cyber_muted" />

                <Button
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="אימות"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/passwordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                android:background="@drawable/cyber_panel_bg">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="סיסמת 2FA"
                    android:inputType="textPassword"
                    android:background="@drawable/cyber_edit_bg"
                    android:textColor="@color/cyber_text"
                    android:textColorHint="@color/cyber_muted" />

                <Button
                    android:id="@+id/btnVerifyPassword"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="אימות סיסמה"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="88dp"
                    android:layout_height="34dp"
                    android:text="הגדרות"
                    android:textSize="10sp"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />

                <Button
                    android:id="@+id/btnCurrentIntel"
                    android:tag="cyber_btn_current"
                    android:layout_width="88dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:text="אקטואלי"
                    android:textSize="10sp"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />

                <Button
                    android:id="@+id/btnVerifyIntel"
                    android:tag="cyber_btn_verify"
                    android:layout_width="88dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:text="אימות"
                    android:textSize="10sp"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />

                <Button
                    android:id="@+id/btnFlights"
                    android:tag="cyber_btn_flights"
                    android:layout_width="88dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:text="מטוסים"
                    android:textSize="10sp"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />

                <Button
                    android:id="@+id/btnMilitaryFlights"
                    android:tag="cyber_btn_military"
                    android:layout_width="96dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:text="צבאיים"
                    android:textSize="10sp"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="58"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/telegramPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.45"
                android:orientation="vertical"
                android:layout_marginStart="4dp"
                android:background="@drawable/cyber_panel_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="עדכוני טלגרם"
                    android:textColor="@color/cyber_green"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMessages"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="4dp"
                    android:clipToPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/verifyPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:orientation="vertical"
                android:layout_marginEnd="4dp"
                android:background="@drawable/cyber_panel_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="אימות ידיעה"
                    android:textColor="@color/cyber_green"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etHomeVerify"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:hint="הדבק ידיעה לבדיקה"
                    android:gravity="top|right"
                    android:minLines="4"
                    android:background="@drawable/cyber_edit_bg"
                    android:textColor="@color/cyber_text"
                    android:textColorHint="@color/cyber_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnHomeVerify"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="בדיקה"
                    android:textSize="12sp"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />

                <TextView
                    android:id="@+id/tvHomeVerifyResult"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:text="ממתין לבדיקה"
                    android:textColor="@color/cyber_text"
                    android:textSize="11sp"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mapPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="42"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:background="@drawable/cyber_panel_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etMapSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="חיפוש אזור בעברית: איראן / תימן / מפרץ"
                    android:singleLine="true"
                    android:background="@drawable/cyber_edit_bg"
                    android:textColor="@color/cyber_text"
                    android:textColorHint="@color/cyber_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnMapSearch"
                    android:layout_width="74dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:text="חפש"
                    android:textSize="12sp"
                    android:background="@drawable/cyber_button_bg"
                    android:textColor="@color/cyber_green" />
            </LinearLayout>

            <com.pasiflonet.mobile.utils.CyberMiddleEastMapView
                android:id="@+id/cyberMap"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnClearCache"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="ניקוי קאש"
                android:textSize="11sp"
                android:background="@drawable/cyber_button_bg"
                android:textColor="@color/cyber_green" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
