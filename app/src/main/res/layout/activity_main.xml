<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cy_bg"
    android:orientation="vertical"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/apiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/cy_card"
        app:cardCornerRadius="6dp"
        app:strokeColor="@color/cy_stroke_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <EditText
                android:id="@+id/etApiId"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:backgroundTint="@color/cy_stroke_soft"
                android:hint="API ID"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:textColor="@color/cy_text"
                android:textColorHint="@color/cy_text_dim" />

            <EditText
                android:id="@+id/etApiHash"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="2dp"
                android:backgroundTint="@color/cy_stroke_soft"
                android:hint="API HASH"
                android:paddingHorizontal="10dp"
                android:textColor="@color/cy_text"
                android:textColorHint="@color/cy_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveApi"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:text="שמירה"
                android:textStyle="bold"
                app:backgroundTint="@color/cy_accent_dark"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/cy_card"
        app:cardCornerRadius="6dp"
        app:strokeColor="@color/cy_stroke_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/phoneLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/cy_stroke_soft"
                    android:hint="מספר טלפון"
                    android:inputType="phone"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/cy_text"
                    android:textColorHint="@color/cy_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendCode"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="2dp"
                    android:text="SEND CODE"
                    app:backgroundTint="@color/cy_accent_dark"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/codeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCode"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/cy_stroke_soft"
                    android:hint="קוד"
                    android:inputType="number"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/cy_text"
                    android:textColorHint="@color/cy_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="2dp"
                    android:text="אימות"
                    app:backgroundTint="@color/cy_accent_dark"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/passwordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/cy_stroke_soft"
                    android:hint="סיסמה"
                    android:inputType="textPassword"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/cy_text"
                    android:textColorHint="@color/cy_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyPassword"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="2dp"
                    android:text="כניסה"
                    app:backgroundTint="@color/cy_accent_dark"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="ניקוי קאש"
                android:textStyle="bold"
                android:textColor="@color/cy_text"
                app:backgroundTint="@color/cy_chip"
                app:cornerRadius="6dp"
                app:strokeColor="@color/cy_stroke_soft"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="4dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="הגדרות"
                android:textStyle="bold"
                android:textColor="@color/cy_text"
                app:backgroundTint="@color/cy_chip"
                app:cornerRadius="6dp"
                app:strokeColor="@color/cy_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:gravity="end"
            android:text="הודעות זמינות לעריכה"
            android:textColor="@color/cy_stroke"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="2dp" />
    </LinearLayout>
</LinearLayout>
