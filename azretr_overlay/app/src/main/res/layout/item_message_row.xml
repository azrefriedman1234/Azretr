<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/row_border"
    android:minHeight="76dp"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvMsgText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Loading..."
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnDetails"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_cyber_icon_button"
        android:contentDescription="Details"
        android:padding="8dp"
        android:src="@android:drawable/arrow_forward"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="00:00"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMsgText" />

    <TextView
        android:id="@+id/tvMediaType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="TXT"
        android:textColor="@color/cyber_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tvTime"
        app:layout_constraintStart_toEndOf="@id/tvTime" />

    <TextView
        android:id="@+id/tvMsgId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="ID"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvTime"
        app:layout_constraintStart_toEndOf="@id/tvMediaType" />

    <TextView
        android:id="@+id/tvSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="-"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvTime"
        app:layout_constraintStart_toEndOf="@id/tvMsgId" />

</androidx.constraintlayout.widget.ConstraintLayout>
